------MultipartBoundary--mBxcMcPIIa3ef26LiT7z4nGTufdHqdgqwcYhY10Wo8----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://www.indonesia.travel/css/legacy.css

@charset "utf-8";

:root { --blue: #071c53; }

h4 { line-height: 1.3 !important; }

body { min-height: 100vh; font-family: Manrope, sans-serif; font-optical-sizing: auto; scroll-padding-top: 80px; }

html { scroll-padding-top: 80px; }

.text-blue { color: var(--blue) !important; }

.bg-blue { background: var(--blue); }

.btn-blue:hover, .btn-blue { color: rgb(255, 255, 255); border: 1px solid var(--blue); font-weight: 700; font-size: 16px; padding: 15px; background: var(--blue) !important; }

.slider-hero-thumb .owl-nav.disabled { display: flex !important; }

.owl-event .owl-nav.disabled { display: flex !important; }

.nav-gradient { background-image: linear-gradient(rgba(0, 0, 0, 0.3), rgba(255, 255, 255, 0)); }

.nav-top { transition: 0.4s; }

.logo-footer { filter: brightness(0) saturate(100%) invert(100%) sepia(100%) saturate(0%) hue-rotate(93deg) brightness(108%) contrast(102%); transition: 0.2s; }

.nav-top .offcanvas.offcanvas-end { height: 100dvh; }

.nav-top li .nav-link { font-size: 16px; font-weight: 600; color: rgb(255, 255, 255); margin: 0px 1.7rem; transition: 0.2s; text-align: center; padding: 0.5rem 0px !important; }

.nav-top li .nav-link.active { font-weight: 600; color: rgb(255, 255, 255); position: relative; }

.nav-top li .nav-link.active::before, .nav-scrolled li .nav-link.active::before { height: 2px; width: 100%; background: rgb(255, 255, 255); position: absolute; bottom: 0px; left: 0px; content: ""; }

.nav-top:hover, .nav-scrolled { background: rgb(255, 255, 255); }

.nav-top.bg-white .logo, .nav-top:hover .logo, .nav-scrolled .logo { filter: none; }

.nav-top.bg-white li .nav-link, .nav-top:hover li .nav-link, .nav-scrolled li .nav-link { color: rgb(123, 123, 123); }

.nav-top.bg-white li .nav-link:hover, .nav-top:hover li .nav-link:hover, .nav-scrolled li .nav-link:hover { color: rgb(7, 28, 83); }

.nav-top.bg-white li .nav-link.active::before, .nav-top:hover li .nav-link.active::before, .nav-scrolled li .nav-link.active::before { background: rgb(123, 123, 123); }

.nav-top.bg-white li .nav-link.active, .nav-top:hover li .nav-link.active, .nav-scrolled li .nav-link.active { color: rgb(7, 28, 83); }

.btn-lang.show, .btn-lang { background: rgba(255, 255, 255, 0.28); font-weight: 600; font-size: 16px; backdrop-filter: blur(10px); border-color: rgba(116, 120, 118, 0.286); color: rgb(255, 255, 255); }

.nav-top:hover .btn-lang, .nav-scrolled .btn-lang { background: rgb(255, 255, 255); color: rgb(123, 123, 123); }

.nav-top:hover .btn-lang:hover { color: var(--blue); }

.btn-search img { filter: brightness(0) invert(1); }

.nav-top:hover .btn-search, .nav-scrolled .btn-search img { filter: brightness(0) saturate(100%) invert(50%) sepia(0%) saturate(0%) hue-rotate(153deg) brightness(92%) contrast(93%); }

footer { background: rgb(2, 11, 34); padding-top: 50px; }

footer p { color: rgb(254, 254, 254); }

footer h5 { font-weight: 800; font-size: 16px; }

footer ul { list-style-type: none; padding: 0px; display: flex; flex-direction: column; gap: 20px; font-weight: 400; }

footer ul li a { color: rgb(255, 255, 255); text-decoration: none; display: inline-flex; gap: 10px; align-items: center; flex-wrap: wrap; word-break: break-word; }

footer ul li a:hover { opacity: 0.8; }

footer ul li a ~ .dropdown-menu { background: rgb(47, 47, 47); padding: 15px; }

footer ul li a ~ .dropdown-menu a { color: rgb(255, 255, 255); display: inline-flex; gap: 10px; align-items: center; }

footer ul li a ~ .dropdown-menu a:hover { background: rgba(255, 255, 255, 0); color: rgb(255, 255, 255); }

footer ul li a ~ .dropdown-menu hr { border-color: rgba(255, 255, 255, 0.4); margin: 13px 0px; }

footer .copyright { border-top: 1px solid rgb(47, 47, 47); }

.dropdown-menu.show { max-height: 300px; overflow: scroll; z-index: 99999; min-width: 250px; }

.dm-flag .dropdown-header { font-weight: 800; color: var(--blue); display: flex; align-items: center; }

.flag-lang { min-width: 20px; display: inline-flex; width: 20px; height: 15px; border-radius: 2px; background: var(--blue); align-items: center; justify-content: center; margin-right: 6px; border: 0.4px solid var(--blue); overflow: hidden; }

.flag-lang img { width: 100%; height: 100%; object-fit: cover; }

.dm-flag .dropdown-item { font-size: 14px; cursor: pointer; }

