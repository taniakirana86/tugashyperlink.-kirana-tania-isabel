.chat-user { display: flex; flex-direction: column; margin-left: auto; }

.chat-user-name { font-weight: 600; text-align: right; color: rgb(0, 0, 0); margin: 0px; }

.chat-bubble-user { background-color: rgb(51, 64, 84); padding: 0.75rem 1rem; border-radius: 0.75rem 0px 0.75rem 0.75rem; color: rgb(230, 233, 238); }

#chat-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 16px; color: rgb(85, 85, 85); font-size: 14px; }

.spinner { width: 32px; height: 32px; border-width: 4px; border-style: solid; border-color: rgb(74, 144, 226) rgb(204, 204, 204) rgb(204, 204, 204); border-image: none; border-radius: 50%; animation: 1s linear 0s infinite normal none running spin; margin-bottom: 8px; }

.mic-button, .lang-button { cursor: pointer; margin-left: 8px; display: flex; align-items: center; padding: 5px; border-radius: 50%; }

.mic-button.listening { background-color: rgb(255, 204, 204); }

.lang-button { background: rgb(238, 238, 238); border-radius: 8px; padding: 5px 10px; font-size: 12px; }

.tts-btn { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; background: none; cursor: pointer; font-size: 14px; }

.tts-btn:hover { color: rgb(0, 123, 255); }

@keyframes spin { 
  100% { transform: rotate(360deg); }
}

@media screen and (max-width: 431px) {
  .ai-modal { right: unset; }
}
